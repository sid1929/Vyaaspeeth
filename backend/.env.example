# --- Required ---
# MongoDB connection string. Create a NEW database user/password; never reuse a credential that was ever committed.
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-host>/<database>?retryWrites=true&w=majority

# Generate each with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace_with_a_long_random_secret_at_least_32_characters
PAYMENT_WEBHOOK_SECRET=replace_with_a_different_long_random_secret

# --- Optional ---
PORT=5000
NODE_ENV=development
# Exact frontend origin(s), comma-separated. No trailing slash.
CORS_ORIGINS=http://localhost:3000
# Set to 1 when running behind one reverse proxy (Render, Heroku, etc.) so rate limits see the real client IP.
TRUST_PROXY=0
# Demo payment gateway. Defaults to ON in development and OFF in production. Never enable with real customers.
ENABLE_MOCK_PAYMENTS=true
